{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optimizam.dev/schema/problem.schema.json",
  "title": "Optimizam problem",
  "description": "A constrained optimization or feasibility problem. Expression strings use the grammar in docs/problem-format.md.",
  "type": "object",
  "required": [
    "version",
    "variables",
    "constraints",
    "solve"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "description": "Format version, \"major.minor\": the version this schema describes.",
      "const": "1.3"
    },
    "sets": {
      "description": "Named index sets used to index variables, parameters, constraints, and sums.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/set"
      }
    },
    "parameters": {
      "description": "Named constant data (scalars or indexed tables) usable in expressions.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "intervals": {
      "description": "Named time intervals for scheduling constraints.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/interval"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "solve": {
      "$ref": "#/$defs/solve"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "not": {
        "enum": [
          "sum",
          "in",
          "and",
          "or",
          "not"
        ]
      }
    },
    "set": {
      "oneOf": [
        {
          "description": "Explicit list of elements.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        {
          "description": "Inclusive integer range.",
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "integer"
            },
            "to": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "parameter": {
      "oneOf": [
        {
          "description": "Scalar constant.",
          "type": "number"
        },
        {
          "description": "Indexed table. 'values' is nested one object level per index set, keyed by set element (integers written as strings).",
          "type": "object",
          "required": [
            "index",
            "values"
          ],
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "index": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "values": {
              "$ref": "#/$defs/table"
            },
            "default": {
              "description": "Value for index combinations missing from 'values'.",
              "type": "number"
            }
          }
        }
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "null",
            "description": "No value: as a variable's bound, no bound for that element."
          },
          {
            "$ref": "#/$defs/table"
          }
        ]
      }
    },
    "bound": {
      "description": "A number, or an expression in the parameters and the indexes that the item's index list names: \"deadline[t] - length[t]\". The bare name of a parameter is one: a scalar, or a table over the item's own sets, applied element by element. A string that is only a number is refused (write it without quotes).",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "indexEntry": {
      "description": "The name of a set, or \"i in SET\", which names the index for the item's bounds and fields.",
      "type": "string",
      "pattern": "^([A-Za-z_][A-Za-z0-9_]* +in +)?[A-Za-z_][A-Za-z0-9_]*$"
    },
    "variable": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "enum": [
            "continuous",
            "integer",
            "binary"
          ]
        },
        "index": {
          "description": "Index sets; e.g. [\"I\", \"J\"] declares x[i,j] for every i in I, j in J. An entry may name its index, [\"i in I\", \"j in J\"], for the bounds and the start to use.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/indexEntry"
          }
        },
        "lower": {
          "$ref": "#/$defs/bound",
          "description": "Omitted means unbounded below."
        },
        "upper": {
          "$ref": "#/$defs/bound",
          "description": "Omitted means unbounded above."
        },
        "domain": {
          "description": "Integer variables only, instead of lower/upper. Either sorted, non-overlapping inclusive ranges, e.g. [[1,3],[7,9]] is {1,2,3,7,8,9}; or the name of a set, making the variable set-valued.",
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            },
            {
              "$ref": "#/$defs/identifier"
            }
          ]
        },
        "start": {
          "$ref": "#/$defs/bound",
          "description": "Optional starting value for local (nonlinear) solvers; moved inside the bounds if outside them."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "binary"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "lower"
                  ]
                },
                {
                  "required": [
                    "upper"
                  ]
                },
                {
                  "required": [
                    "domain"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "domain"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "integer"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "lower"
                  ]
                },
                {
                  "required": [
                    "upper"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Optional. Instances of an indexed constraint are named name[i,...].",
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string"
        },
        "forall": {
          "description": "Bindings that replicate the constraint, e.g. \"i in I, j in J: i != j\".",
          "type": "string"
        },
        "expr": {
          "description": "A comparison of two expressions: lhs <= rhs, lhs >= rhs, or lhs == rhs; between integer-valued sides also lhs != rhs, lhs < rhs, or lhs > rhs. abs, min, and max are functions in expressions (there are no constraint kinds of those names).",
          "type": "string"
        },
        "all_different": {
          "$ref": "#/$defs/list",
          "description": "The listed expressions take pairwise different values."
        },
        "element": {
          "type": "object",
          "required": [
            "index",
            "array",
            "value"
          ],
          "additionalProperties": false,
          "description": "value equals the array item selected by index (by set element).",
          "properties": {
            "index": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "array": {
              "$ref": "#/$defs/list"
            },
            "value": {
              "type": "string"
            }
          }
        },
        "table": {
          "type": "object",
          "required": [
            "vars",
            "tuples"
          ],
          "additionalProperties": false,
          "description": "The listed variables equal one of the tuples (or none of them, with forbidden).",
          "properties": {
            "vars": {
              "$ref": "#/$defs/list"
            },
            "tuples": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "integer",
                    "string"
                  ]
                }
              }
            },
            "forbidden": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "no_overlap": {
          "$ref": "#/$defs/list",
          "description": "A list of intervals that must not overlap."
        },
        "cumulative": {
          "type": "object",
          "required": [
            "intervals",
            "demands",
            "capacity"
          ],
          "additionalProperties": false,
          "description": "At every time, the demands of the intervals in progress add up to at most capacity.",
          "properties": {
            "intervals": {
              "$ref": "#/$defs/list"
            },
            "demands": {
              "$ref": "#/$defs/list"
            },
            "capacity": {
              "type": "string"
            }
          }
        },
        "enforce_if": {
          "description": "Only with expr: a conjunction of literals (b, not b, v == e, v != e); the relation must hold when all are true.",
          "type": "string"
        }
      },
      "description": "Exactly one kind field (expr, all_different, element, table, min, max, abs, no_overlap, cumulative).",
      "oneOf": [
        {
          "required": [
            "expr"
          ]
        },
        {
          "required": [
            "all_different"
          ]
        },
        {
          "required": [
            "element"
          ]
        },
        {
          "required": [
            "table"
          ]
        },
        {
          "required": [
            "no_overlap"
          ]
        },
        {
          "required": [
            "cumulative"
          ]
        }
      ],
      "dependentRequired": {
        "enforce_if": [
          "expr"
        ]
      }
    },
    "solve": {
      "description": "What to solve for. Modeled on FlatZinc JSON's solve block.",
      "type": "object",
      "required": [
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "satisfy",
            "minimize",
            "maximize"
          ]
        },
        "objective": {
          "description": "Expression to optimize. Required for minimize/maximize, not allowed for satisfy.",
          "type": "string"
        },
        "solutions": {
          "description": "'one': a single feasible (satisfy) or optimal (minimize/maximize) solution. 'all': every feasible or every optimal solution. A number N: at most N of them.",
          "oneOf": [
            {
              "enum": [
                "one",
                "all"
              ]
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "default": "one"
        }
      },
      "if": {
        "properties": {
          "method": {
            "const": "satisfy"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "objective"
          ]
        }
      },
      "else": {
        "required": [
          "objective"
        ]
      }
    },
    "interval": {
      "type": "object",
      "required": [
        "name",
        "start",
        "duration"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string"
        },
        "index": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/indexEntry"
          }
        },
        "start": {
          "$ref": "#/$defs/bound",
          "description": "A number or an affine expression: often the name of a variable or a parameter indexed by the same sets as the interval."
        },
        "duration": {
          "$ref": "#/$defs/bound",
          "description": "A number or an affine expression: often the name of a variable or a parameter indexed by the same sets as the interval."
        },
        "presence": {
          "type": "string",
          "description": "Optional binary variable (by name, if it is indexed by the same sets, or as on[t]); the interval is present when it is 1."
        }
      }
    },
    "list": {
      "description": "A list: \"[expr | bindings]\" or \"[expr, expr, ...]\".",
      "type": "string"
    }
  }
}
