{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optimizam.dev/schema/problem.schema.json",
  "title": "Optimizam problem",
  "description": "A constrained optimization or feasibility problem. Expression strings use the grammar in docs/problem-format.md.",
  "type": "object",
  "required": ["version", "variables", "constraints", "solve"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "description": "Format version, \"major.minor\". This schema describes major version 1.",
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "sets": {
      "description": "Named index sets used to index variables, parameters, constraints, and sums.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/set" }
    },
    "parameters": {
      "description": "Named constant data (scalars or indexed tables) usable in expressions.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/parameter" }
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/variable" }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint" }
    },
    "solve": { "$ref": "#/$defs/solve" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "not": { "enum": ["sum", "in", "and", "or", "not"] }
    },
    "set": {
      "oneOf": [
        {
          "description": "Explicit list of elements.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": ["string", "integer"] }
        },
        {
          "description": "Inclusive integer range.",
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": {
            "from": { "type": "integer" },
            "to": { "type": "integer" }
          }
        }
      ]
    },
    "parameter": {
      "oneOf": [
        { "description": "Scalar constant.", "type": "number" },
        {
          "description": "Indexed table. 'values' is nested one object level per index set, keyed by set element (integers written as strings).",
          "type": "object",
          "required": ["index", "values"],
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string" },
            "index": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/identifier" }
            },
            "values": { "$ref": "#/$defs/table" },
            "default": {
              "description": "Value for index combinations missing from 'values'.",
              "type": "number"
            }
          }
        }
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/table" }]
      }
    },
    "bound": {
      "description": "A number, or the name of a parameter indexed by the same sets as the variable (applied element-wise).",
      "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/identifier" }]
    },
    "variable": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string" },
        "type": { "enum": ["continuous", "integer", "binary"] },
        "index": {
          "description": "Index sets; e.g. [\"I\", \"J\"] declares x[i,j] for every i in I, j in J.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "lower": { "$ref": "#/$defs/bound", "description": "Omitted means unbounded below." },
        "upper": { "$ref": "#/$defs/bound", "description": "Omitted means unbounded above." },
        "domain": {
          "description": "Integer variables only, instead of lower/upper. Sorted, non-overlapping inclusive ranges; e.g. [[1,3],[7,9]] is {1,2,3,7,8,9}.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "integer" }, { "type": "integer" }],
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "binary" } } },
          "then": { "not": { "anyOf": [{ "required": ["lower"] }, { "required": ["upper"] }, { "required": ["domain"] }] } }
        },
        {
          "if": { "required": ["domain"] },
          "then": {
            "properties": { "type": { "const": "integer" } },
            "not": { "anyOf": [{ "required": ["lower"] }, { "required": ["upper"] }] }
          }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "required": ["expr"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Optional. Instances of an indexed constraint are named name[i,...].",
          "$ref": "#/$defs/identifier"
        },
        "description": { "type": "string" },
        "forall": {
          "description": "Bindings that replicate the constraint, e.g. \"i in I, j in J: i != j\".",
          "type": "string"
        },
        "expr": {
          "description": "lhs <= rhs, lhs >= rhs, or lhs == rhs.",
          "type": "string"
        }
      }
    },
    "solve": {
      "description": "What to solve for. Modeled on FlatZinc JSON's solve block.",
      "type": "object",
      "required": ["method"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["satisfy", "minimize", "maximize"] },
        "objective": {
          "description": "Expression to optimize. Required for minimize/maximize, not allowed for satisfy.",
          "type": "string"
        },
        "solutions": {
          "description": "'one': a single feasible (satisfy) or optimal (minimize/maximize) solution. 'all': every feasible or every optimal solution.",
          "enum": ["one", "all"],
          "default": "one"
        }
      },
      "if": { "properties": { "method": { "const": "satisfy" } } },
      "then": { "not": { "required": ["objective"] } },
      "else": { "required": ["objective"] }
    }
  }
}
