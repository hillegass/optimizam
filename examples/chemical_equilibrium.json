{
  "version": "1.2",
  "sets": { "SPECIES": { "from": 1, "to": 10 }, "ELEMENTS": ["H", "N", "O"] },
  "parameters": {
    "c": { "index": ["SPECIES"], "values": { "1": -6.089, "2": -17.164, "3": -34.054, "4": -5.914, "5": -24.721,
      "6": -14.986, "7": -24.1, "8": -10.708, "9": -26.662, "10": -22.179 } },
    "atoms": { "index": ["ELEMENTS", "SPECIES"], "default": 0, "values": {
      "H": { "1": 1, "2": 2, "3": 2, "6": 1, "10": 1 },
      "N": { "4": 1, "5": 2, "6": 1, "7": 1 },
      "O": { "3": 1, "7": 1, "8": 1, "9": 2, "10": 1 } } },
    "supply": { "index": ["ELEMENTS"], "values": { "H": 2, "N": 1, "O": 1 } }
  },
  "variables": [
    { "name": "moles", "type": "continuous", "index": ["SPECIES"], "lower": 1e-6, "start": 0.1 }
  ],
  "constraints": [
    { "name": "balance", "forall": "e in ELEMENTS", "expr": "sum(j in SPECIES) atoms[e, j] * moles[j] == supply[e]" }
  ],
  "solve": {
    "method": "minimize",
    "objective": "sum(j in SPECIES) moles[j] * (c[j] + ln(moles[j] / sum(k in SPECIES) moles[k]))"
  }
}
