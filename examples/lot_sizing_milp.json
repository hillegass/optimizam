{
  "$schema": "../schema/problem.schema.json",
  "version": "1.0",
  "sets": {
    "PRODUCTS": [
      "bolts",
      "nuts",
      "rivets"
    ],
    "PERIODS": {
      "from": 1,
      "to": 24
    }
  },
  "parameters": {
    "demand": {
      "index": [
        "PRODUCTS",
        "PERIODS"
      ],
      "values": {
        "bolts": {
          "1": 0,
          "2": 24,
