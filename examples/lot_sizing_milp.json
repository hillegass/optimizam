          "22": 44,
          "23": 0,
          "24": 22
        }
      }
    },
    "setup_cost": {
      "index": [
        "PRODUCTS"
      ],
      "values": {
        "bolts": 98,
        "nuts": 192,
        "rivets": 101
      }
    },
    "hold_cost": {
      "index": [
        "PRODUCTS"
      ],
      "values": {
        "bolts": 4,
        "nuts": 4,
        "rivets": 3
      }
    },
    "capacity": 89,
    "big_m": 1435
  },
  "variables": [
    {
      "name": "make",
      "type": "continuous",
      "index": [
        "PRODUCTS",
        "PERIODS"
      ],
      "lower": 0
    },
    {
      "name": "stock",
      "type": "continuous",
      "index": [
        "PRODUCTS",
        "PERIODS"
      ],
      "lower": 0
    },
    {
      "name": "setup",
      "type": "binary",
      "index": [
        "PRODUCTS",
        "PERIODS"
      ]
    }
  ],
  "constraints": [
    {
      "name": "first_period",
      "forall": "p in PRODUCTS, t in PERIODS: t == 1",
      "expr": "make[p,t] - stock[p,t] == demand[p,t]"
    },
    {
      "name": "balance",
      "forall": "p in PRODUCTS, t in PERIODS: t > 1",
      "expr": "stock[p,t-1] + make[p,t] - stock[p,t] == demand[p,t]"
    },
    {
      "name": "setup_link",
      "forall": "p in PRODUCTS, t in PERIODS",
      "expr": "make[p,t] <= big_m * setup[p,t]"
    },
    {
      "name": "capacity",
      "forall": "t in PERIODS",
      "expr": "sum(p in PRODUCTS) make[p,t] <= capacity"
    }
  ],
  "solve": {
    "method": "minimize",
    "objective": "sum(p in PRODUCTS, t in PERIODS) (setup_cost[p] * setup[p,t] + hold_cost[p] * stock[p,t])",
    "solutions": "one"
  }
}
