{
  "$schema": "../schema/problem.schema.json",
  "version": "1.3",
  "sets": {
    "N": {
      "from": 1,
      "to": 9
    },
    "DIGITS": {
      "from": 1,
      "to": 9
    }
  },
  "parameters": {
    "given": {
      "description": "The clues; 0 where a cell is blank",
      "index": [
        "N",
        "N"
      ],
      "values": {
        "1": {
          "1": 5,
          "2": 3,
          "5": 7
        },
        "2": {
          "1": 6,
          "4": 1,
          "5": 9,
          "6": 5
        },
        "3": {
          "2": 9,
          "3": 8,
          "8": 6
        },
        "4": {
          "1": 8,
          "5": 6,
          "9": 3
        },
        "5": {
          "1": 4,
          "4": 8,
          "6": 3,
          "9": 1
        },
        "6": {
          "1": 7,
          "5": 2,
          "9": 6
        },
        "7": {
          "2": 6,
          "7": 2,
          "8": 8
        },
        "8": {
          "4": 4,
          "5": 1,
          "6": 9,
          "9": 5
        },
        "9": {
          "5": 8,
          "8": 7,
          "9": 9
        }
      },
      "default": 0
    }
  },
  "variables": [
    {
      "name": "cell",
      "type": "integer",
      "index": [
        "N",
        "N"
      ],
      "domain": "DIGITS"
    }
  ],
  "constraints": [
    {
      "name": "clues",
      "forall": "r in N, c in N: given[r,c] > 0",
      "expr": "cell[r,c] == given[r,c]"
    },
    {
      "name": "rows",
      "forall": "r in N",
      "all_different": "[cell[r,c] | c in N]"
    },
    {
      "name": "columns",
      "forall": "c in N",
      "all_different": "[cell[r,c] | r in N]"
    },
    {
      "name": "boxes",
      "forall": "b in N",
      "all_different": "[cell[r,c] | r in N, c in N: 3 * div(r - 1, 3) + div(c - 1, 3) + 1 == b]"
    }
  ],
  "solve": {
    "method": "satisfy",
    "solutions": "all"
  }
}
