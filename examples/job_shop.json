{
  "$schema": "../schema/problem.schema.json",
  "version": "1.1",
  "sets": {
    "JOBS": [
      1,
      2,
      3
    ],
    "STEPS": [
      1,
      2,
      3
    ],
    "MACHINES": [
      1,
      2,
      3
    ]
  },
  "parameters": {
    "machine": {
      "index": [
        "JOBS",
        "STEPS"
      ],
      "values": {
        "1": {
          "1": 1,
          "2": 2,
          "3": 3
        },
        "2": {
          "1": 2,
          "2": 1,
          "3": 3
        },
        "3": {
          "1": 2,
          "2": 3,
          "3": 1
        }
      }
    },
    "length": {
      "index": [
        "JOBS",
        "STEPS"
      ],
      "values": {
        "1": {
          "1": 3,
          "2": 2,
          "3": 2
        },
        "2": {
          "1": 2,
          "2": 1,
          "3": 4
        },
        "3": {
          "1": 4,
          "2": 3,
          "3": 1
        }
      }
    }
  },
  "variables": [
    {
      "name": "begin",
      "type": "integer",
      "index": [
        "JOBS",
        "STEPS"
      ],
      "lower": 0,
      "upper": 100
    },
    {
      "name": "makespan",
      "type": "integer",
      "lower": 0,
      "upper": 100
    }
  ],
  "intervals": [
    {
      "name": "op",
      "index": [
        "JOBS",
        "STEPS"
      ],
      "start": "begin",
      "duration": "length"
    }
  ],
  "constraints": [
    {
      "forall": "j in JOBS, s in STEPS: s > 1",
      "expr": "begin[j,s] >= begin[j,s-1] + length[j,s-1]"
    },
    {
      "forall": "m in MACHINES",
      "no_overlap": "[op[j,s] | j in JOBS, s in STEPS: machine[j,s] == m]"
    },
    {
      "max": {
        "value": "makespan",
        "of": "[begin[j,s] + length[j,s] | j in JOBS, s in STEPS]"
      }
    }
  ],
  "solve": {
    "method": "minimize",
    "objective": "makespan"
  }
}
