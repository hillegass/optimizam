  "variables": [
    {
      "name": "make",
      "type": "continuous",
      "index": [
        "PLANTS",
        "PRODUCTS",
        "PERIODS"
      ],
      "lower": 0
    },
    {
      "name": "ship",
      "type": "continuous",
      "index": [
        "PLANTS",
        "MARKETS",
        "PRODUCTS",
        "PERIODS"
      ],
      "lower": 0
    },
    {
      "name": "stock",
      "type": "continuous",
      "index": [
        "PLANTS",
        "PRODUCTS",
        "PERIODS"
      ],
      "lower": 0
    },
    {
      "name": "short",
      "type": "continuous",
      "index": [
        "MARKETS",
        "PRODUCTS",
        "PERIODS"
      ],
      "lower": 0,
      "description": "Unmet demand, penalized"
    }
  ],
  "constraints": [
    {
      "name": "plant_capacity",
      "forall": "f in PLANTS, t in PERIODS",
      "expr": "sum(p in PRODUCTS) hours[p] * make[f,p,t] <= plant_hours[f]"
    },
    {
      "name": "first_balance",
      "forall": "f in PLANTS, p in PRODUCTS, t in PERIODS: t == 1",
      "expr": "stock[f,p,t] == initial_stock[f,p] + make[f,p,t] - sum(m in MARKETS) ship[f,m,p,t]"
    },
    {
      "name": "balance",
      "forall": "f in PLANTS, p in PRODUCTS, t in PERIODS: t > 1",
      "expr": "stock[f,p,t] == stock[f,p,t-1] + make[f,p,t] - sum(m in MARKETS) ship[f,m,p,t]"
    },
    {
      "name": "storage_limit",
      "forall": "f in PLANTS, t in PERIODS",
      "expr": "sum(p in PRODUCTS) stock[f,p,t] <= storage[f]"
    },
    {
      "name": "meet_demand",
      "forall": "m in MARKETS, p in PRODUCTS, t in PERIODS",
      "expr": "sum(f in PLANTS) ship[f,m,p,t] + short[m,p,t] == demand[m,p,t]"
    },
    {
      "name": "lane",
      "forall": "f in PLANTS, m in MARKETS, t in PERIODS",
      "expr": "sum(p in PRODUCTS) ship[f,m,p,t] <= lane_cap[f,m]"
    }
  ],
  "solve": {
    "method": "minimize",
    "objective": "sum(f in PLANTS, p in PRODUCTS, t in PERIODS) (make_cost[f,p] * make[f,p,t] + hold_cost[p] * stock[f,p,t]) + sum(f in PLANTS, m in MARKETS, p in PRODUCTS, t in PERIODS) ship_cost[f,m] * ship[f,m,p,t] + sum(m in MARKETS, p in PRODUCTS, t in PERIODS) shortage_penalty * short[m,p,t]",
    "solutions": "one"
  }
}
