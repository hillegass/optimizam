  "variables": [
    {
      "name": "open",
      "type": "binary",
      "index": [
        "FACILITIES"
      ]
    },
    {
      "name": "modules",
      "type": "integer",
      "index": [
        "FACILITIES"
      ],
      "lower": 0,
      "upper": 4
    },
    {
      "name": "serve",
      "type": "continuous",
      "index": [
        "FACILITIES",
        "CUSTOMERS"
      ],
      "lower": 0
    }
  ],
  "constraints": [
    {
      "name": "meet_demand",
      "forall": "c in CUSTOMERS",
      "expr": "sum(f in FACILITIES) serve[f,c] == demand[c]"
    },
    {
      "name": "capacity",
      "forall": "f in FACILITIES",
      "expr": "sum(c in CUSTOMERS) serve[f,c] <= module_size * modules[f]"
    },
    {
      "name": "modules_need_open",
      "forall": "f in FACILITIES",
      "expr": "modules[f] <= 4 * open[f]"
    },
    {
      "name": "serve_need_open",
      "forall": "f in FACILITIES, c in CUSTOMERS",
      "expr": "serve[f,c] <= demand[c] * open[f]"
    }
  ],
  "solve": {
    "method": "minimize",
    "objective": "sum(f in FACILITIES) (open_cost[f] * open[f] + module_cost[f] * modules[f]) + sum(f in FACILITIES, c in CUSTOMERS) unit_cost[f,c] * serve[f,c]",
    "solutions": "one"
  }
}
