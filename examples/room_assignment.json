{
  "$schema": "../schema/problem.schema.json",
  "version": "1.3",
  "sets": {
    "TALKS": ["keynote", "workshop", "panel"],
    "ROOMS": ["hall", "lab", "lounge"]
  },
  "variables": [
    { "name": "room", "type": "integer", "index": ["TALKS"], "domain": "ROOMS", "description": "The room each talk is in" }
  ],
  "constraints": [
    { "name": "one_talk_per_room", "all_different": "[room[t] | t in TALKS]" }
  ],
  "solve": {
    "method": "satisfy",
    "solutions": "all"
  }
}
