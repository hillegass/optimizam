{
  "$schema": "../schema/problem.schema.json",
  "version": "1.3",
  "variables": [
    { "name": "batches", "type": "integer", "lower": 0 },
    { "name": "overtime", "type": "continuous", "lower": 0 }
  ],
  "constraints": [
    { "name": "staffing", "expr": "3 * batches - 2 * overtime <= 5" }
  ],
  "solve": {
    "method": "maximize",
    "objective": "10 * batches - overtime",
    "solutions": "one"
  }
}
