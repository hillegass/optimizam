{
  "$schema": "../schema/problem.schema.json",
  "version": "1.3",
  "sets": {
    "T": {
      "from": 1,
      "to": 6
    }
  },
  "parameters": {
    "demand": {
      "index": [
        "T"
      ],
      "values": {
        "1": 4,
        "2": 7,
        "3": 2,
        "4": 8,
        "5": 5,
        "6": 3
      }
    }
  },
  "variables": [
    {
      "name": "make",
      "type": "integer",
      "index": [
        "T"
      ],
      "lower": 0,
      "upper": 10
    }
  ],
  "constraints": [
    {
      "name": "smooth",
      "description": "A batch differs from the one before by at most 3",
      "forall": "t in T: t > 1",
      "expr": "abs(make[t] - make[t-1]) <= 3"
    }
  ],
  "solve": {
    "method": "minimize",
    "objective": "sum(t in T) 2 * abs(make[t] - demand[t]) + sum(t in T: t > 1) abs(make[t] - make[t-1]) - min(t in T) make[t]"
  }
}
